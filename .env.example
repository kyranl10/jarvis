# Copy this file to .env and fill in your own values. Never commit .env.

# Push notifications (free): a long, hard-to-guess name you make up, e.g. jarvis-q7m2x9vk4p
NTFY_TOPIC=

# Outlook calendar: the published ICS link (see README, step 3)
OUTLOOK_ICS_URL=

# Canvas: Calendar > Calendar Feed link
CANVAS_ICS_URL=

# Work (optional): the job's published Outlook calendar, its name, and its email domain.
# Work email reaches Jarvis through an Outlook rule that redirects it to the Gmail "Jarvis" label.
WORK_ICS_URL=
WORK_NAME=VenueHorn
WORK_EMAIL_DOMAIN=venuehorn.com

# Marching Tar Heels: GroupSpot > calendar > ... > sync link. It has a private token, keep it secret.
GROUPSPOT_ICAL_URL=

# Gmail app password: myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional settings
JARVIS_NAME=Kyran
TIMEZONE=America/New_York
LATITUDE=35.9132
LONGITUDE=-79.0558

# Instagram (optional): Meta's Business Discovery API, for captions from accounts you follow (see jarvis/instagram.py)
INSTAGRAM_USER_ID=
INSTAGRAM_TOKEN=
INSTAGRAM_WATCH=aplasticplant

# Mail triage encryption key (python -m jarvis.mailstore keygen). Also a GitHub Actions secret.
MAIL_KEY=
